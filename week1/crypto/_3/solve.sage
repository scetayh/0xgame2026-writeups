# 有限域
F = GF(p)

# 求 a = log_g(A)
a = discrete_log(F(A), F(g))
print("a =", a)

# 验证 H_i == sha256(str(B_i^a mod p))
from hashlib import sha256

ok = True
for i, (bi, hi) in enumerate(zip(B, H)):
    K = pow(bi, int(a), p)
    h = sha256(str(K).encode()).hexdigest()
    if h != hi:
        ok = False
        print(f"mismatch at {i}")
        print("got :", h)
        print("want:", hi)

print("verify H =", ok)
